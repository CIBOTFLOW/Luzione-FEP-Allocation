{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.luzione.example/luzione-movement-post-v0.1-draft.schema.json",
  "title": "Luzione movement post request v0.1 draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["displayName", "handle", "location", "caption", "mediaItems", "publicationConsentVerified", "idempotencyKey"],
  "properties": {
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "handle": { "type": "string", "pattern": "^@?[A-Za-z0-9._-]{2,40}$" },
    "location": { "type": "string", "minLength": 1, "maxLength": 120 },
    "caption": { "type": "string", "minLength": 1, "maxLength": 500 },
    "mediaItems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/mediaItem" }
    },
    "publicCaseCode": { "type": ["string", "null"], "minLength": 1, "maxLength": 120 },
    "publicationConsentVerified": { "const": true },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 }
  },
  "$defs": {
    "mediaItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "mimeType", "byteSize", "sha256", "altText"],
      "properties": {
        "fileName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "mimeType": { "enum": ["image/png", "image/jpeg", "image/webp", "video/mp4", "video/webm"] },
        "byteSize": { "type": "integer", "minimum": 1, "maximum": 25000000 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "altText": { "type": "string", "minLength": 1, "maxLength": 180 }
      }
    }
  }
}
