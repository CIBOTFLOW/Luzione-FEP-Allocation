{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.luzione.example/luzione-movement-comment-v0.1-draft.schema.json",
  "title": "Luzione movement comment request v0.1 draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["parentCommentId", "displayName", "handle", "text", "attachment"],
  "properties": {
    "parentCommentId": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "handle": { "type": "string", "pattern": "^@?[A-Za-z0-9._-]{2,40}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 400 },
    "attachment": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fileName", "mimeType", "byteSize", "sha256", "altText"],
          "properties": {
            "fileName": { "type": "string", "minLength": 1, "maxLength": 120 },
            "mimeType": { "enum": ["image/png", "image/jpeg", "image/webp"] },
            "byteSize": { "type": "integer", "minimum": 1, "maximum": 25000000 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "altText": { "type": "string", "minLength": 1, "maxLength": 180 }
          }
        }
      ]
    }
  }
}
